  "agent": "01a0f61b-3e85-75a4-852f-0db7d9173b98",
  "rationale": "First design of sylva, adopted from what the code already is: three layers (structures, log, knowledge) as in docs/DESIGN.md, each component linked to its code, with the rules, checks and decisions the design document states.",
  "why": "this agent's trust level is `propose`",
  "ops": [
    {
      "op": "claim.add",
      "id": "01a10a4f-5ab1-7400-9299-a9cc95c56d41",
      "node": "01a10a4b-cdce-72a2-82d1-d5122b03d702",
      "text": "Determinism: the same ops give the same state, byte for byte, on every machine; iteration follows key order, never insertion order or slot layout."
    },
    {
      "op": "claim.add",
      "id": "01a10a4f-5ab1-7400-9299-a9cda4d666d0",
      "node": "01a10a4b-cdce-72a2-82d1-d5122b03d702",
      "text": "Pure Rust; SQLite is the one native dependency, optional and bundled, so the crate builds for desktop, server and iOS."
    },
    {
      "op": "claim.add",
      "id": "01a10a4f-5ab1-7400-9299-a9ce740219a7",
      "node": "01a10a4b-cdce-72a2-82d1-d5122b03d702",
      "text": "No graph database, query language, general collection library or algorithm catalogue: only the walks and queries Sylva's users need."
    },
    {
