      "node": "01a10a4f-5ab1-7400-9299-a9d0451ab1bc",
      "text": "Ordered BTreeMap index, not a hash map",
      "why": "Deterministic iteration with no extra sorting, and no hasher dependency.",
      "rests_on": [
        {
          "of": "doc:design/8. Decisions",
          "at": "fp:26cad878d474",
          "checked": "2026-10-05"
        }
      ]
    },
    {
      "op": "claim.add",
      "id": "01a10a4f-5ab2-7523-9906-b3282a112452",
      "node": "01a10a4f-5ab1-7400-9299-a9d362272e19",
      "text": "Adjacency sorted by edge key",
      "why": "Same order as a scan of all edges by key, so results didn't change when the scan went away.",
      "rests_on": [
        {
          "of": "doc:design/8. Decisions",
          "at": "fp:26cad878d474",
          "checked": "2026-10-05"
        }
      ]
    },
    {
      "op": "claim.add",
      "id": "01a10a4f-5ab2-7523-9906-b32977429487",
      "node": "01a10a4f-5ab1-7400-9299-a9d625241c70",
      "text": "Conflicts as data, not errors",
      "why": "Merged histories must always replay; people resolve what doesn't apply.",
      "rests_on": [
        {
          "of": "doc:design/8. Decisions",
          "at": "fp:26cad878d474",
          "checked": "2026-10-05"
        }
      ]
    },
    {
      "op": "claim.add",
      "id": "01a10a4f-5ab2-7523-9906-b32a41b7ad3c",
      "node": "01a10a4f-5ab1-7400-9299-a9dd5b2db6f0",
      "text": "The caller picks the signature domain",
      "why": "One key can't be tricked into signing for another purpose. Tend's domain stays `alfred-tend-batch-v1\\n` so existing signatures remain valid.",
      "rests_on": [
        {
          "of": "doc:design/8. Decisions",
          "at": "fp:26cad878d474",
          "checked": "2026-10-05"
        }
      ]
    },
    {
      "op": "claim.add",
      "id": "01a10a4f-5ab2-7523-9906-b32b65ff817a",
      "node": "01a10a4f-5ab1-7400-9299-a9df21aab3fa",
      "text": "Encryption keys derived per application",
      "why": "One master key can serve several apps (HMAC-SHA256 of `<app>/v1/data`) without any two sharing a data key.",
      "rests_on": [
        {
          "of": "doc:design/8. Decisions",
          "at": "fp:26cad878d474",
          "checked": "2026-10-05"
        }
      ]
    },
    {
      "op": "claim.add",
      "id": "01a10a4f-5ab2-7523-9906-b32cc7a6bb44",
      "node": "01a10a4b-cdce-72a2-82d1-d5122b03d702",
      "text": "Extracted from Alfred",
      "why": "Sylva was extracted from Alfred so Alfred and Tend build on one implementation; its bar is Alfred's benchmark baseline (alfred/docs/benchmarks/baseline.md), checked by benchmarks rather than assumed.",
      "rests_on": [
        {
          "of": "doc:design/1. Goals and non-goals",
