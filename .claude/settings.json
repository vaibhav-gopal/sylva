{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "tend session touched --agent claude-code",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|write_file|replace|apply_patch"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "tend session end --agent claude-code",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "tend env context --agent claude-code",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
